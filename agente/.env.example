# Copia este archivo como .env y llena lo que vayas a usar.
# Nunca subas el .env a GitHub.

# ---------- Cerebro (IA) ----------
# "gemini" (capa gratuita de Google AI Studio) u "openai"
LLM_PROVEEDOR=gemini
GEMINI_API_KEY=
# Flash-Lite tiene límites gratis más amplios (la voz hace varias peticiones por minuto).
# Si te sale "429 Too Many Requests", espera un minuto o usa otro modelo de AI Studio.
LLM_MODELO=gemini-2.5-flash-lite
# Si usas OpenAI:
# LLM_PROVEEDOR=openai
# OPENAI_API_KEY=
# LLM_MODELO=gpt-5-mini

# ---------- Base de datos ----------
# Vacío = memoria con el restaurante demo (se borra al reiniciar).
# Supabase → Project Settings → API. La service_role key SOLO va en el servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Restaurante para la demo en navegador y la página de prueba (vacío = el primero)
RESTAURANTE_ID=

# ---------- Voz ----------
# Deepgram hace el oído y la voz con la misma llave (console.deepgram.com,
# trae crédito gratis sin tarjeta). Así la demo cuesta $0.
DEEPGRAM_API_KEY=
# "deepgram" (gratis) o "cartesia" (más natural, plan gratis pequeño)
VOZ_PROVEEDOR=deepgram
# Voces en español de Deepgram: aura-2-celeste-es, aura-2-valentina-es,
# aura-2-estrella-es, aura-2-nestor-es, aura-2-alvaro-es... prueben varias.
DEEPGRAM_VOZ=aura-2-celeste-es
# Solo si VOZ_PROVEEDOR=cartesia (play.cartesia.ai)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# ---------- Teléfono (solo para llamadas reales) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---------- WhatsApp Cloud API (Meta) ----------
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
# Lo inventas tú y lo pegas igual en Meta al registrar el webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
# Plantillas aprobadas en Meta (3 variables: nombre, fecha, personas)
WHATSAPP_PLANTILLA_CONFIRMADA=
WHATSAPP_PLANTILLA_RECHAZADA=
WHATSAPP_IDIOMA_PLANTILLAS=es_MX

# ---------- Avisos del panel ----------
# Supabase manda aquí cuando el equipo aprueba/rechaza. Inventa una clave larga.
EVENTOS_SECRETO=

# ---------- Página de prueba ----------
# 1 = activa http://localhost:8000/prueba. NUNCA en el servidor público.
MODO_PRUEBA=1
