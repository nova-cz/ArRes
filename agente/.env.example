# Copia este archivo como .env y llena lo que vayas a usar.
# Nunca subas el .env a GitHub.

# ---------- Cerebro (IA) ----------
# "gemini" (capa gratuita de Google AI Studio) u "openai"
LLM_PROVEEDOR=gemini
GEMINI_API_KEY=
# Usa el modelo Flash más reciente que aparezca en AI Studio
LLM_MODELO=gemini-2.5-flash
# Si usas OpenAI:
# LLM_PROVEEDOR=openai
# OPENAI_API_KEY=
# LLM_MODELO=gpt-5-mini

# ---------- Base de datos ----------
# Vacío = memoria con el restaurante demo (se borra al reiniciar).
# Supabase → Project Settings → API. La service_role key SOLO va en el servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Restaurante para la demo en navegador y la página de prueba (vacío = el primero)
RESTAURANTE_ID=

# ---------- Voz ----------
# Deepgram (oído): console.deepgram.com · Cartesia (voz): play.cartesia.ai
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
# Elige una voz en español en play.cartesia.ai y pega su ID
CARTESIA_VOICE_ID=

# ---------- Teléfono (solo para llamadas reales) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---------- WhatsApp Cloud API (Meta) ----------
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
# Lo inventas tú y lo pegas igual en Meta al registrar el webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
# Plantillas aprobadas en Meta (3 variables: nombre, fecha, personas)
WHATSAPP_PLANTILLA_CONFIRMADA=
WHATSAPP_PLANTILLA_RECHAZADA=
WHATSAPP_IDIOMA_PLANTILLAS=es_MX

# ---------- Avisos del panel ----------
# Supabase manda aquí cuando el equipo aprueba/rechaza. Inventa una clave larga.
EVENTOS_SECRETO=

# ---------- Página de prueba ----------
# 1 = activa http://localhost:8000/prueba. NUNCA en el servidor público.
MODO_PRUEBA=1
