# Copia como .env.local (y en Vercel → Settings → Environment Variables).
# Supabase → Project Settings → API Keys. Aquí va la PUBLISHABLE, nunca la secret.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Solo en el servidor (sin NEXT_PUBLIC_): la usa "Pegar menú" para leer el texto con IA.
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash-lite
# Solo servidor: para "Escuchar" las voces en la sección Agente (la misma de agente/.env).
DEEPGRAM_API_KEY=
# Dirección del agente de voz para "Hablar con el agente" (en local, la de python voz/bot.py).
NEXT_PUBLIC_AGENTE_URL=http://localhost:7860/client/
