# Copia como .env.local (y en Vercel → Settings → Environment Variables).
# Supabase → Project Settings → API Keys. Aquí va la PUBLISHABLE, nunca la secret.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Solo en el servidor (sin NEXT_PUBLIC_): la usa "Pegar menú" para leer el texto con IA.
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash-lite
